# Copy the frontend block into frontend/.env.local.
# Copy the functions block into functions/.env (Firebase loads that file on deploy).
# Never commit real secrets. Replace the project id before the first deploy.

# ---------- Frontend (NEXT_PUBLIC_*) ----------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5001
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fire-factory.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fire-factory
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fire-factory.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Auth emulator (local only):
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------- Functions / API ----------
# Production must NOT set USE_MEMORY_STORE or ALLOW_TEST_AUTH.
# USE_MEMORY_STORE=1
# ALLOW_TEST_AUTH=1

FB_PROJECT_ID=fire-factory
FUNCTION_REGION=us-central1
PUBLIC_SITE_URL=http://127.0.0.1:3000
# Comma-separated extra browser origins. Localhost is allowed outside production.
ALLOWED_ORIGINS=
